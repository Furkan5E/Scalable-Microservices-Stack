FROM python:3.14-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:$PATH"

COPY web/ ./

# Run as an unprivileged user; the numeric UID lets Kubernetes verify runAsNonRoot.
# gunicorn keeps its control socket in the home directory, so the user needs one.
RUN useradd --system --uid 10001 --create-home appuser
USER 10001

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--preload", "app:app"]
